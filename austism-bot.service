[Unit]
Description=Austism Bot + Web
After=network.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/austism
EnvironmentFile=/opt/austism/.env
ExecStart=/usr/bin/node server/src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=DB_PATH=/opt/austism/data/skin_walkers.db

[Install]
WantedBy=multi-user.target
